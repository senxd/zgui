[
  {
    "name": "workspace-tests",
    "command": [
      "cargo",
      "test",
      "--workspace",
      "--all-targets",
      "--locked"
    ],
    "exit_code": 0
  },
  {
    "name": "doctests",
    "command": [
      "cargo",
      "test",
      "--workspace",
      "--doc",
      "--locked"
    ],
    "exit_code": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--workspace",
      "--all-targets",
      "--locked",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  },
  {
    "name": "macos-check",
    "command": [
      "cargo",
      "check",
      "--workspace",
      "--all-targets",
      "--target",
      "aarch64-apple-darwin",
      "--locked"
    ],
    "exit_code": 0
  },
  {
    "name": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit_code": 0
  },
  {
    "name": "build",
    "command": [
      "cargo",
      "build",
      "-p",
      "zgui-desktop",
      "--example",
      "measured_virtual_list",
      "--example",
      "variable_virtual_list",
      "--example",
      "virtual_keyboard",
      "--locked"
    ],
    "exit_code": 0
  }
]
